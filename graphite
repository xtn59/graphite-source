def fileExists(file):
	if os.path.exists(file):
		return True
	elif not os.path.exists(file):
		print(f"error: file does not exist.\n^ {file}")
		return False

def getFiles(button,playlist,plfile):
	global _sel_sng,_sng_lst,_cur_inx,_pus,_ply,artist_label,file_extension,_sng_raw_nme,_art_nme,song_path,_graphite,cover_w,cover_h,_music_user_directory,cover_path,_notifications

	if playlist == False:
		if button == 1:

			if _music_user_directory.startswith("~"):
				_music_user_directory = _music_user_directory.replace("~", f"{Path.home()}", 1)

			path = filex(_music_user_directory,False)
			if _music_user_directory == path:
				return
			elif _sel_sng != None and os.path.dirname(_sel_sng) == path:
				return
		elif button == 0:
			path = os.getcwd()
		elif button == 5: 
			for i in _arg_lst:
				if i.startswith("--dir="):
					path = i.split("--dir=")[1]
					if path.startswith('~') == True:
						path = path.replace("~", f"{Path.home()}", 1)
	subprocess.run("clear")

	files = []
	files_cover = []

	if playlist == False:
		if path:
			files = sorted([f for f in os.listdir(path) if f.endswith(('.mp3','.wav','.ogg','.flac','.aac','.m4a','.alac'))])
			files_cover = [f for f in os.listdir(path) if f.lower().endswith(('.jpg','.png'))]
	else:
		#This will allow us to read the paths of songs from the user's selected playlist.
		#The user can right click on a file in filex to add it to the playlist.

		with open(plfile, 'r') as f:
			for line in f:
				lne = (str(line)).strip('\n')
				if lne.endswith(('.mp3','.wav','.ogg','.flac','.aac','.m4a','.alac')):
					if fileExists(lne):
						files.append(lne)
				elif lne.endswith(('.jpg','.png')):
					if fileExists(lne):
						files_cover.append(lne)

	try:
		if files:
			if playlist == False:
				_sng_lst = [os.path.join(path, f) for f in files]
			else:
				_sng_lst = files
			if len(_sng_lst) > 0:
				_cur_inx = 0
				_sel_sng = _sng_lst[_cur_inx]
				_sng_raw_nme, file_extension = os.path.splitext(os.path.basename(_sel_sng))
				pygame.mixer.music.stop()
				_pus = False

				_tinytag = TinyTag.get(_sel_sng)
				print(f"{_tinytag.year} - {_tinytag.album} by {_tinytag.artist}")

				for f in _sng_lst:
					if playlist == True:
						print(f"p       {os.path.basename(f)}")
					else:
						print(f"\t{os.path.basename(f)}")
			else:
				printf("error: no songs in song list.")
		else:
			_cur_inx = 0
			_sng_lst = []
			_sel_sng = None
			_song_label.config(text='no songs')
			pygame.mixer.music.stop()
			_pus = False

	except Exception as e:
		print(f"error: {e}")

	if files_cover:
		if playlist == False:
			cover_file = os.path.join(path, files_cover[0])
		else:
			cover_file = str(files_cover[0]).strip()
		try:
			displayLogo(cover_file)
		except Exception as e:
			pass
	else:
		displayLogo(_logo2_directory)
	
	if len(_sng_lst) > 0:
		playThisSong()

	updateInformation()

