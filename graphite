def playThisSong():
	global _pus, _ply, _cur_inx, file_extension, _sng_raw_nme, song_path, _notifications, cover_path
	if _sel_sng:
		pygame.mixer.music.load(_sel_sng)
		pygame.mixer.music.set_volume(float(_glb_vol))
		pygame.mixer.music.play()
		_pus = False
		_ply = True
		_sng_raw_nme, file_extension = os.path.splitext(str(os.path.basename(_sel_sng)))

		_tinytag = TinyTag.get(str(_sel_sng))
		_art_nme = _tinytag.artist
		artist_label.config(text=str(_art_nme.lower()))
		_song_label.config(text=str(_sng_raw_nme.lower()))
		_dos.title(f'{_sng_raw_nme.lower()}')
		modifyStatus(_sng_raw_nme.lower())

	if _notifications == 1:
		subprocess.run(["notify-send", f"{_sng_raw_nme} - {_art_nme}", "-i", cover_path], shell=True)

def playEvent(event=None):
	global _song_label,_pus,_ply,_art_nme
	if _pus:
		pygame.mixer.music.unpause()
		play_button.config(fg=_fg)
		_pus = False
		_ply = True
	elif _ply:
		pygame.mixer.music.pause()
		_pus = True
		_ply = False
	else:
		if not _sel_sng:
			_song_label.config(text='no files given')
			return
		else:
			playThisSong()


def volumeEvent(event,incdec):
	global _glb_vol,vol_button
	
	if incdec == 0:
		if _glb_vol < Decimal('1.00'):
			_glb_vol += Decimal('0.05')
			pygame.mixer.music.set_volume(float(_glb_vol))
			vol_button.config(text=str(_glb_vol))
	elif incdec == 1:
		if _glb_vol > Decimal('0.00'):
			_glb_vol -= Decimal('0.05')
			pygame.mixer.music.set_volume(float(_glb_vol))
			vol_button.config(text=str(_glb_vol))

def skipEvent(event,state):
	global _glb_vol, _cur_inx, _sel_sng
	if state == "back":
		if _cur_inx - 1 >= 0:
			_cur_inx -= 1
			_sel_sng = _sng_lst[_cur_inx]
			playThisSong()
	elif state == "forward":
		if _cur_inx + 1 < len(_sng_lst):
			_cur_inx += 1
			_sel_sng = _sng_lst[_cur_inx]
			playThisSong()

def updateInformation():
	global _ply, _pus, _sel_sng, _cur_inx, _sng_lst, play, _ply_info, _art_nme

	if _ply:
		if pygame.mixer.music.get_busy():
			pass
		elif not _pus:
			if _repeat == True:
				_sel_sng = _sng_lst[_cur_inx]
				playThisSong()
			else:
				if _cur_inx + 1 < len(_sng_lst):
					_cur_inx += 1
					_sel_sng = _sng_lst[_cur_inx]
					playThisSong()
				else:
					_cur_inx = 0
					_sel_sng = _sng_lst[_cur_inx]
					playThisSong()
			if _shuffle == True:
				random_number = random.randint(0,len(_sel_sng))
				_sel_sng = _sng_lst[random_number]
				_cur_inx = random_number
				playThisSong()

	if _ply == True:
		play_button.config(text='stop')
	elif _pus == True:
		play_button.config(text='play')
	elif _pus == False and _ply == False:
		play_button.config(text='play')

	_dos.after(100, updateInformation)

