def read_from_config():
	global _notifications
	with open(config_path, 'r') as cfg:
		for line in cfg:
			if (' = ' not in line and ';' not in line):
				continue
			key, value = line.split(' = ', 1)
			key = key.strip()
			value = value.strip()
			value = value.strip(';')
		
			if key == 'foreground':
				_fg = str(value)
			elif key == 'background':
				_bg = str(value)
			elif key == 'font':
				_fnt = (str(value), 10)
			elif key == 'directory to choose music from':
				_music_user_directory = str(value)
			elif key == 'logo2 directory':
				_logo2_directory = value
			elif key == 'logo3 directory':
				_logo3_directory = value
			elif key == 'send notifs on song play':
				_notifications = int(value)
			elif key == 'dir x':
				_def_dirx = value
			elif key == 'play x':
				_def_playx = value
			elif key == 'vol x':
				_def_volx = value
			elif key == 'passed x':
				_def_passedx = value
			elif key == 'artist x':
				_def_artistx = value
			elif key == 'song x':
				_def_songx = value
			elif key == 'status x':
				_def_statusx = value
			elif key == 'dir y':
				_def_diry = value
			elif key == 'play y':
				_def_playy = value
			elif key == 'vol y':
				_def_voly = value
			elif key == 'passed y':
				_def_passedy = value
			elif key == 'artist y':
				_def_artisty = value
			elif key == 'song y':
				_def_songy = value
			elif key == 'status y':
				_def_statusy = value

	return _def_dirx, _def_playx, _def_songx, _def_volx, _def_passedx, _def_artistx, _def_statusx, _def_diry, _def_playy, _def_songy, _def_voly, _def_passedy, _def_artisty, _def_statusy, _fg, _bg, _fnt, _music_user_directory, _logo2_directory, _logo3_directory

