def switchState(event,state):
	global _repeat, _shuffle

	if state == 'repeat':
		_shuffle = False
		if _repeat == False:
			_repeat = True
			status_label.config(text='R')
		elif _repeat == True:
			_repeat = False
			status_label.config(text=' ')
	elif state == 'shuffle':
		_repeat = False
		if _shuffle == False:
			_shuffle = True
			status_label.config(text='S')
		elif _shuffle == True:
			_shuffle = False
			status_label.config(text=' ')

