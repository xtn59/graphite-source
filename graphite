	_dos2.config(bg=_bg)

	if playlist == False:
	
		_return = Label(_dos2, fg=_fg,bg=_bg,font=_fnt,text="<-",cursor='hand2')
		_return.place(x=5,y=5)
		_return.bind('<Enter>', lambda event: _return.config(fg='grey'))
		_return.bind('<Leave>', lambda event: _return.config(fg=_fg))
		_return.bind('<Button-1>', lambda event: retur())
	
		_ok = Label(_dos2, fg=_fg,bg=_bg,font=_fnt,text="ok",cursor='hand2')
		_ok.place(x=25,y=5)
		_ok.bind('<Enter>', lambda event: _ok.config(fg='grey'))
		_ok.bind('<Leave>', lambda event: _ok.config(fg=_fg))
		_ok.bind('<Button-1>', lambda event: end_filex(False,None))

		_new = Label(_dos2,fg=_fg,bg=_bg,font=_fnt,text="new",cursor='hand2')
		_new.place(x=45,y=5)
		_new.bind('<Enter>', lambda event: _new.config(fg='grey'))
		_new.bind('<Leave>', lambda event: _new.config(fg=_fg))
		_new.bind('<Button-1>', lambda event: make_playlist())

		_ent = Entry(_dos2,fg=_fg,bg=_bg,bd=0,highlightcolor=_fg,highlightbackground=_fg,font=_fnt)

	def create_playlist():
		nonlocal _filex_path, _ent

		_playlist_name = str(_ent.get())
		if _playlist_name != None:
			subprocess.run([f'touch \"{os.path.join(_filex_path, _playlist_name)}\"'], shell=True)
			print(f"created file at;   {os.path.join(_filex_path, _playlist_name)}")
		_ent.place(y=10000)
		_ent.delete(0, END)
		_dos2.title(f"{_filex_path}")
		shfiles()

	def make_playlist():
		nonlocal _filex_path, _dosh, _ent

		_filex_path = _playlist_folder
		shfiles()
		_dos2.title(f"creating playlist at {_filex_path}")
		_ent.place(x=(_dosw / 2) - 50,y=(_dosh / 2) - 10,width=100,height=20)
		_ent.bind('<Return>', lambda event: create_playlist())

	def end_filex(playlist,plname):
		nonlocal _pl_to_return
		if playlist == True:
			_pl_to_return = plname
		_dos2.destroy()

	def retur():
		nonlocal _filex_path
		_filex_path = os.path.dirname(_filex_path)
		shfiles()
	
	def shdots():
		nonlocal _shdots

		if _shdots == True:
			_shdots = False
		elif _shdots == False:
			_shdots = True

		shfiles()
	
	def shfiles():
		nonlocal _label_lst, _shdots, _filex_path, _dosh, playlist

		if playlist == False:
			offset_y = 20
			_dos2.title(f'{_filex_path}')
		elif playlist == True:
			offset_y = 0
			_dos2.title("choose a playlist")

		if _shdots == False:
			_file_lst = sorted([f for f in os.listdir(_filex_path) if not f.startswith('.')])
		else:
			_file_lst = sorted([f for f in os.listdir(_filex_path)])

		if len(_label_lst) > 0:
			for i in _label_lst:
				i.destroy()
	
			_label_lst.clear()
	
		def change_path(path,file):
			nonlocal _filex_path

			if os.path.isdir(os.path.join(_filex_path, file)) == True:
				_filex_path = path
				shfiles()
			else:
				print('not a directory')
	
		for f in _file_lst:
			_file_label = Label(_dos2, text=f,fg=_fg,bg=_bg,font=_fnt,cursor='hand2')
			_label_lst.append(_file_label)
		
		for i in _label_lst:
			i.place(x=10,y=(10 + offset_y))
			i.bind('<Enter>', lambda event, it=i: it.config(fg='grey'))
			i.bind('<Leave>', lambda event, it=i: it.config(fg=_fg))
			if playlist == False:
				i.bind('<Button-1>', lambda event, it=i: change_path(os.path.join(_filex_path, it.cget('text')), str(it.cget('text'))))
				if str(i.cget('text')).endswith(('.mp3','.wav','.ogg','.flac','.aac','.m4a','.alac','.png','.jpg')):
					i.bind('<Button-3>', lambda event, it=i: writeToPlaylist(os.path.join(_filex_path, it.cget('text'))))
			else:
				i.bind('<Button-1>', lambda event, it=i: end_filex(True, str(os.path.join(_filex_path, it.cget('text')))))

			_place_info = i.place_info()
			_dos2.geometry(f'{_dosw}x{int(_place_info['y']) + 22}')
			_dosh = (int(_place_info['y']) + 22)
			offset_y += 15

		offset_y = 0
		_file_lst = []
	
	shfiles()
	_dos2.bind('<period>', lambda event: shdots())
	_dos.wait_window(_dos2)
	if playlist == False:
		return _filex_path
	elif playlist == True:
		return _pl_to_return

